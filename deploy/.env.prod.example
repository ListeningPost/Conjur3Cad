# Production env for the VM Docker Compose stack. Copy to deploy/.env.
# (Secrets stay on the VM; never commit the real .env.)

# Real Firebase project (NOT a demo- project). Admin SDK uses the VM's attached
# service account via ADC — no key file needed.
FIREBASE_PROJECT_ID=your-project-id

# Single live session per seat key. Idle sessions free the seat after this.
SESSION_TTL_SECONDS=90

# Per-key request cap (defense in depth; not customer-facing metering).
RATE_LIMIT_PER_MIN=240

# REDIS_URL / UPSTREAM_MCP_URL / PORT are set by docker-compose.prod.yml.
# Override UPSTREAM_MCP_URL here only if running FreeCAD on the host:
# UPSTREAM_MCP_URL=http://host.docker.internal:8765/mcp

# CORS allow-origin for browser MCP clients. "*" for testing; e.g. https://claude.ai for prod.
CORS_ORIGIN=*
