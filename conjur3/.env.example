# Conjur3 environment template. Copy to `.env` and fill in.
# docker-compose automatically loads `.env` from this directory.

# ---- MCP server-side ----

# Bearer token the MCP server requires on every request. Pass the SAME value
# in your Anthropic API call's mcp_servers[].authorization_token.
# Leave blank for local-only dev (no auth — only safe on loopback).
MCP_AUTH_TOKEN=

# Password for VNC / noVNC. Leave blank for no password (loopback only).
VNC_PASSWORD=

# Set to 1 to spawn a cloudflared quick-tunnel for the MCP port.
# The trycloudflare.com URL is printed in `docker logs conjur3`.
CONJUR3_DEV_TUNNEL=0

# ---- Anthropic API client-side ----
# Used by scripts/anthropic_e2e.py (and any other client you write).
# Get yours at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Where the MCP is reachable FROM the Anthropic API. For local dev with
# CONJUR3_DEV_TUNNEL=1, paste the cloudflared URL here. For production,
# paste your private deployment URL.
# Note: Hermes Agent connects to conjur3:8765/mcp directly over the internal
# Docker network — this MCP_URL only affects the pilot-ui Anthropic proxy.
MCP_URL=http://localhost:8765/mcp

# ---- Hermes Agent / Hermes WebUI ----

# Optional password to protect the Hermes WebUI at http://localhost:8787.
# Leave blank for open access (safe on localhost; set it for remote exposure).
HERMES_WEBUI_PASSWORD=

# Host UID/GID for shared volume ownership. Leave blank to use the default
# (1000). If you see "Permission denied" errors in hermes-agent or hermes-webui
# logs, set these to the output of: id -u   and   id -g
UID=
GID=
