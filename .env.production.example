# ---------------------------------------------------------------------------
# Conjur3 web app — PRODUCTION build config (Firebase Hosting via web frameworks).
# Copy to `.env.production` (gitignored) and fill in real values. These
# NEXT_PUBLIC_* vars are baked into the client bundle at build time, so the
# Hosting build (scripts/deploy-firebase.sh → `firebase deploy --only hosting`)
# must see them.
# ---------------------------------------------------------------------------

# --- Firebase (web SDK) ---------------------------------------------------
# Firebase console → Project settings → Your apps → SDK setup & config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Platform admins (UI gating only) -------------------------------------
# Comma-separated operator emails that see the /platform pages. Must match
# PLATFORM_ADMIN_EMAILS in functions/.env.<projectId>, which is what actually
# authorizes them.
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=

# --- Live services (NOT emulators) ----------------------------------------
NEXT_PUBLIC_USE_EMULATORS=false

# --- Stripe (publishable key only on the client) --------------------------
# Secret key + webhook secret live on the Firebase Stripe Extension, not here.
# While Stripe is disabled via the config/flags feature flag these are unused,
# but set them once billing is turned on.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
NEXT_PUBLIC_STRIPE_SEAT_PRICE_ID=price_xxx
