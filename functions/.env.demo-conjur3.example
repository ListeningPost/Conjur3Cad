# Cloud Functions runtime env. Copy to functions/.env.<projectId> (gitignored);
# for local emulator dev that is functions/.env.demo-conjur3.

# Comma-separated emails of this deployment's platform super-admins. They can
# grant seats, issue seat vouchers and mint/revoke keys in any org, and only
# qualify with a VERIFIED email. Leave empty for no platform admins.
PLATFORM_ADMIN_EMAILS=

# Public URL of the web app, used in invite links.
APP_URL=http://localhost:3000

# Transactional email (optional). Without RESEND_API_KEY, emails are logged.
EMAIL_FROM=
RESEND_API_KEY=
