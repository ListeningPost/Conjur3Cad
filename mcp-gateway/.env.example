# ── Conjur3 MCP Gateway ───────────────────────────────────────────────────
# Authenticated, single-session reverse proxy in front of the conjur3-pilot MCP.

# Port the gateway listens on (Caddy/nginx terminates TLS and proxies here).
PORT=8080

# The upstream Conjur3 MCP (conjur3-pilot), Streamable-HTTP endpoint.
# This is the real value from Conjur3/.mcp.json.
UPSTREAM_MCP_URL=http://localhost:8765/mcp

# Redis: session pointers, eviction pub/sub, entitlement cache, rate limits.
REDIS_URL=redis://localhost:6379

# Firebase / Firestore (source of truth for keys, orgs, seats).
# On a GCP VM, leave creds empty and attach a service account — Application
# Default Credentials are picked up automatically (no key file).
FIREBASE_PROJECT_ID=demo-conjur3
# Local dev against the emulator: point Admin SDK at it.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8088

# One live session per seat key. Idle sessions free the seat after this TTL.
SESSION_TTL_SECONDS=90

# Per-key request rate limit (defense in depth; not customer-facing metering).
RATE_LIMIT_PER_MIN=240

NODE_ENV=development

# CORS allow-origin for browser MCP clients (claude.ai connectors). "*" for testing.
CORS_ORIGIN=*
