# ---------------------------------------------------------------------------
# Conjur3 web app environment.
# Copy to `.env.local` and fill in. NEXT_PUBLIC_* values are exposed to the
# browser; everything else is server-only (Next.js route handlers).
# ---------------------------------------------------------------------------

# --- Firebase (web SDK) ---------------------------------------------------
# From Firebase console → Project settings → Your apps → SDK setup & config.
# For pure emulator dev you can leave these as the demo values below.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-conjur3.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-conjur3
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-conjur3.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Platform admins (UI gating only) -------------------------------------
# Comma-separated operator emails that see the /platform pages. Must match
# PLATFORM_ADMIN_EMAILS in functions/.env.<projectId>, which is what actually
# authorizes them.
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=

# --- Emulator suite -------------------------------------------------------
# When "true", the web SDK connects to the local Firebase emulators instead
# of live services (see firebase.json for ports). Set "false" in production.
NEXT_PUBLIC_USE_EMULATORS=true

# --- Stripe (publishable key only on the client) --------------------------
# Secret key + webhook secret are configured on the Firebase Stripe Extension,
# not here. See SETUP.md.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# The Firestore price id for the seat-based plan the billing page checks out.
NEXT_PUBLIC_STRIPE_SEAT_PRICE_ID=price_xxx

# --- Redis (server-side: caching + rate limiting) -------------------------
# Optional. If unset, the app runs without Redis (rate limiting/cache no-op).
# Local: matches docker-compose.yml. Prod: Upstash or GCP Memorystore.
REDIS_URL=redis://localhost:6379
# Alternatively, Upstash serverless REST (preferred on serverless hosting):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
